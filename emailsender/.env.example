# Sender identity
EMAILSENDER_FROM_EMAIL=amer.hwitat@proton.me
EMAILSENDER_FROM_NAME=Amer Hwitat

# Proton SMTP submission token (NEVER commit the real token)
EMAILSENDER_SMTP_USERNAME=amer.hwitat@proton.me
EMAILSENDER_SMTP_TOKEN=replace-with-a-Proton-SMTP-token

# Optional authenticated relay (NEVER commit real credentials)
EMAILSENDER_RELAY_HOST=smtp.example.org
EMAILSENDER_RELAY_PORT=587
EMAILSENDER_RELAY_SECURITY=starttls
EMAILSENDER_RELAY_USERNAME=relay-user
EMAILSENDER_RELAY_PASSWORD=replace-with-relay-password
