{
  "schema_version": 1,
  "project": "BizX/NLP Retro Emulator Stack",
  "policy": {
    "source": "Build upstream open-source emulators from pinned revisions; do not vendor or relicense upstream source.",
    "roms": "No proprietary ROM or Kickstart images are redistributed.",
    "certification": "A media artifact becomes certified only after its target emulator smoke test succeeds."
  },
  "targets": {
    "C64": {"emulator":"VICE","source":"https://github.com/VICE-Team/svn-mirror","license":"GPL-2.0-or-later"},
    "C128": {"emulator":"VICE","source":"https://github.com/VICE-Team/svn-mirror","license":"GPL-2.0-or-later"},
    "VIC20": {"emulator":"VICE","source":"https://github.com/VICE-Team/svn-mirror","license":"GPL-2.0-or-later"},
    "Plus4": {"emulator":"VICE","source":"https://github.com/VICE-Team/svn-mirror","license":"GPL-2.0-or-later"},
    "PET": {"emulator":"VICE","source":"https://github.com/VICE-Team/svn-mirror","license":"GPL-2.0-or-later"},
    "Atari800": {"emulator":"Atari800","source":"https://github.com/atari800/atari800","license":"GPL-2.0-or-later"},
    "AppleII": {"emulator":"AppleWin","source":"https://github.com/AppleWin/AppleWin","license":"GPL-2.0-or-later"},
    "ZXSpectrum": {"emulator":"Fuse/libspectrum","source":"https://github.com/fuse-emulator/libspectrum","license":"GPL-2.0-or-later"},
    "AmstradCPC": {"emulator":"Caprice32","source":"https://github.com/ColinPitrat/caprice32","license":"GPL-2.0-or-later"},
    "MSX": {"emulator":"openMSX","source":"https://github.com/openMSX/openMSX","license":"GPL-2.0-or-later"},
    "BBCMicro": {"emulator":"B-em","source":"https://github.com/stardot/b-em","license":"GPL-2.0-or-later"},
    "TRS80": {"emulator":"MAME","source":"https://github.com/mamedev/mame","license":"BSD-3-Clause"},
    "Amiga500": {"emulator":"FS-UAE","source":"https://github.com/FrodeSolheim/fs-uae","license":"GPL-2.0-or-later"},
    "AtariST": {"emulator":"Hatari","source":"https://github.com/hatari/hatari","license":"GPL-2.0-or-later"}
  }
}
